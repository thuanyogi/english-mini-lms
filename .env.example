# Copy thành .env.local và điền giá trị thật. KHÔNG commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
DATABASE_URL=postgresql://user:password@host:5432/postgres
GEMINI_API_KEY=replace-me

# Google Drive Integration (tuỳ chọn — chỉ cần nếu dùng Drive sync)
# Nén file JSON service account thành 1 dòng rồi dán vào đây
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"lms-drive-reader@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
# ID của thư mục Google Drive chứa manifest.yaml + texts/ transcripts/ rubrics/
GOOGLE_DRIVE_FOLDER_ID=1abc123XYZ_replace_me
